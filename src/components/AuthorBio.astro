---
import { BIO } from '../lib/bio.ts';
---

<div class="bio" data-pagefind-ignore>
  <div class="av" aria-hidden="true">GL</div>
  <div>
    <small>ABOUT THE AUTHOR</small>
    <p>{BIO} <a class="bio-more" href="/profile/">About Gabriel →</a></p>
  </div>
</div>

<style>
  .bio-more {
    font-weight: 600;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
</style>
