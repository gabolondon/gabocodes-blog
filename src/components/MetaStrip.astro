---
import { readMinutes, formatMonth, repoName, repoLabels, type Post } from '../lib/post.ts';
interface Props {
  post: Post;
}
const { post } = Astro.props;
const d = post.data;
const labels = repoLabels(d);
---

<div class="meta-strip">
  <div><small>Read</small>{readMinutes(post.body)} min</div>
  {d.stack && <div><small>{labels.stack}</small>{d.stack.join(' · ')}</div>}
  {d.result && <div><small>Result</small>{d.result}</div>}
  <div><small>Published</small>{formatMonth(d.date)}</div>
  {
    d.repo_url && (
      <div class="repo-cell">
        <small>{labels.repo}</small>
        <a href={d.repo_url} rel="noopener">{repoName(d.repo_url)} ↗</a>
      </div>
    )
  }
</div>
